{
  "name": "claudeck",
  "productName": "Claudeck",
  "version": "1.0.0",
  "description": "Varias cuentas de claude.ai abiertas a la vez, cada una con su sesión aislada",
  "author": "Claudeck",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.claudeck",
    "productName": "Claudeck",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Claudeck-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Claudeck-Portable-${version}.${ext}"
    }
  }
}
