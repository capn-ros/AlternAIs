{
  "name": "claudeck",
  "productName": "AlternIAs",
  "version": "1.0.0",
  "description": "Dos IAs en una app (Claude y Replit): varias cuentas abiertas a la vez, cada una con su sesión aislada",
  "author": "Andrés Londero",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.claudeck",
    "productName": "AlternIAs",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "AlternIAs-Portable-${version}.${ext}"
    }
  }
}
